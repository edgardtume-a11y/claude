+                digest = hashlib.sha256(fh.read()).hexdigest()[:16]
+        except OSError:
+            digest = "desconocido"
+        _RUNTIME_ID = {
+            "collector_sha256_16": digest,
+            "event_loop": type(loop).__name__,
+            "loop_time_resolucion": _resolucion_loop_time(loop),
+            "metric_schema_version": METRIC_SCHEMA_VERSION,
+        }
+    return _RUNTIME_ID
