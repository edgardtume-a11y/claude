+# --- [28/08/2026] ACK durable y guarda anti-autorreinicio --------------------
+# ESTADO_DIR vive FUERA de REPO_DIR a proposito: sync_repo() hace
+# 'git reset --hard' en cada ciclo y se llevaria por delante cualquier marca
+# guardada dentro del repositorio.
+ESTADO_DIR = "/home/trading/puente_estado"
+MAX_INTENTOS = 1
+
+# Una orden no puede reiniciar el servicio que la esta ejecutando: se mata a
+# mitad de orden, arranca de nuevo, ve la orden sin resultado y la repite.
+# Paso el 28/08/2026 y dejo el puente ciego 29 minutos (start-limit-hit).
+# Se permite el patron diferido (nohup + retardo) de reiniciar_guardian.sh.
+AUTO_REINICIO_RE = re.compile(
+    r"systemctl\s+(?:--?\S+\s+)*(?:restart|stop|kill)\s+(?:\S+\s+)*puente-github",
+    re.IGNORECASE)
+
+
+def _estado_path(order_id):
+    return os.path.join(ESTADO_DIR, order_id + ".json")
+
+
+def leer_estado(order_id):
+    try:
+        with open(_estado_path(order_id)) as fh:
+            return json.load(fh)
+    except (OSError, ValueError):
+        return None
+
+
+def marcar_estado(order_id, estado, **extra):
+    """ACK durable con fsync: sobrevive a que nos maten a mitad de orden."""
+    os.makedirs(ESTADO_DIR, exist_ok=True)
+    doc = leer_estado(order_id) or {"id": order_id, "intentos": 0}
+    if estado == "started":
+        doc["intentos"] = int(doc.get("intentos", 0)) + 1
+    doc["estado"] = estado
+    doc[estado + "_utc"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+    doc.update(extra)
+    tmp = _estado_path(order_id) + ".tmp"
+    with open(tmp, "w") as fh:
+        json.dump(doc, fh, ensure_ascii=False, sort_keys=True)
+        fh.flush()
+        os.fsync(fh.fileno())
+    os.replace(tmp, _estado_path(order_id))
+    return doc
+
 
