# Copiar a .env y completar. .env nunca se sube (ver .gitignore).

# Telegram: hablale a @BotFather para crear el bot y sacar el token.
# El chat_id lo saca @userinfobot, o mandale un mensaje al bot y consulta
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vacio = trackear todos los simbolos que transmita cada exchange.
# Con valor: lista separada por comas, ej: BTCUSDT,ETHUSDT,TUTUSDT
SYMBOLS_WHITELIST=

# Bybit no tiene firehose "todos los simbolos" como Binance: hay que suscribirse
# simbolo por simbolo. Si SYMBOLS_WHITELIST esta vacio, se suscribe a los N
# simbolos USDT-perp con mayor turnover24h (se refresca solo).
BYBIT_TOP_N_SYMBOLS=100

# Cuantas monedas (top por volumen) trackea el poller de funding rate /
# open interest -- el dato "estilo CoinGlass" que se agrega a cada alerta.
MARKET_TOP_N=100
MARKET_SNAPSHOT_INTERVAL_SECONDS=300

# Umbral en USD para alertar una liquidacion individual grande.
SINGLE_EVENT_ALERT_USD=250000

# Umbral en USD para alertar un cluster (varias liquidaciones del mismo lado
# concentradas en precio y tiempo -> estructura de mercado tipo "muro").
CLUSTER_ALERT_USD=750000
CLUSTER_WINDOW_SECONDS=120
CLUSTER_PRICE_BUCKET_PCT=0.15

# Minimo de segundos entre dos alertas del mismo tipo/simbolo/lado, para no
# spamear Telegram.
ALERT_COOLDOWN_SECONDS=300

DB_PATH=liquidations.db
LOG_LEVEL=INFO
